@"
# ---------- Environment / secrets ----------
.env
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*`$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# ---------- Virtual environments ----------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3
fitness.db

# ---------- Testing / coverage ----------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- OS files ----------
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log
logs/
"@ | Out-File -FilePath .gitignore -Encoding utf8